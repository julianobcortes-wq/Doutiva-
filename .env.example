# Supabase (required)
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite client mirrors (same publishable values; never put service role here)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI gateway (Lovable today; replace with first-party keys when decoupling)
LOVABLE_API_KEY=
# Optional overrides to leave Lovable without code changes:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai.gateway.lovable.dev/v1
# DOUTIVA_CHAT_MODEL=openai/gpt-6-astra
# DOUTIVA_EMBED_MODEL=google/gemini-embedding-2

# Drizzle migrations (optional local)
LOVABLE_DB_MIGRATION_URL=

# Cron auth (optional)
LOVABLE_CRON_SECRET=
