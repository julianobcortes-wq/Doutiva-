# === Doutiva — Supabase PRÓPRIO (não use o projeto Lovable Cloud) ===
# Provisionar com: node scripts/bootstrap-independent-supabase.mjs
# Requer SUPABASE_ACCESS_TOKEN no ambiente (Account → Access Tokens).

SUPABASE_PROJECT_ID=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite client mirrors (same publishable values; never put service role here)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Postgres (migrations / drizzle). Preenchido pelo bootstrap.
# DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# SUPABASE_DB_PASSWORD=

# === Management API (só no ambiente do agente / CI — nunca no browser) ===
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_ORG_ID=
# SUPABASE_REGION=sa-east-1
# SUPABASE_PROJECT_NAME=doutiva

# === IA first-party (não depender do gateway Lovable) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AI_GATEWAY_BASE_URL=https://api.openai.com/v1
DOUTIVA_CHAT_MODEL=gpt-4.1-mini
# Must match pgvector dim in 0020_embedding_dim_1536.sql (1536 for text-embedding-3-small)
DOUTIVA_EMBED_MODEL=text-embedding-3-small
# Dual-provider raise-bar (Claude treatise + OpenAI structure)
# DOUTIVA_CLAUDE_TREATISE_MODEL=claude-opus-4-5
# DOUTIVA_CLAUDE_AUDIT_MODEL=claude-haiku-4-5


# === Google OAuth (Auth do projeto Doutiva — não vai para o browser) ===
# Criar cliente "Aplicativo da Web" no Google Cloud com redirect:
#   https://ynmlbkfdjxzmsndcquap.supabase.co/auth/v1/callback
# Depois: node scripts/enable-google-auth.mjs
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Lovable Cloud: CORTADO. Não use LOVABLE_* em produção.

# === Produto (opcionais) ===
# APP_ORIGIN=https://your-domain.com
# CRON_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=Doutiva <noreply@your-domain.com>

# Stripe (quando definido, /billing abre Checkout em vez de cortesia manual)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_DEFAULT=price_...
# STRIPE_PRICE_FUNDADOR=price_...
# STRIPE_PRICE_PRO=price_...
# Webhook endpoint: POST /api/stripe/webhook (evento checkout.session.completed)
