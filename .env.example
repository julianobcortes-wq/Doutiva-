# Supabase (required)
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite client mirrors (same publishable values; never put service role here)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI gateway (Lovable today; replace with first-party keys when decoupling)
LOVABLE_API_KEY=

# Drizzle migrations (optional local)
LOVABLE_DB_MIGRATION_URL=

# Cron auth (optional)
LOVABLE_CRON_SECRET=
